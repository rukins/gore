# Login against auth.latere.ai. Only read when the configuration file sets
# auth.enable to "latere". Copy this file to .env and fill it in.

# Base URL of the auth service.
AUTH_URL=https://auth.latere.ai

# The OAuth client registered for this deployment. Its redirect_uris must
# include <host>/a/.auth/callback, and its allowed_origins must include the
# host, or the browser will refuse the token exchange.
AUTH_CLIENT_ID=

# Optional. A confidential client sends a secret; a public client relies on
# PKCE and leaves this empty.
AUTH_CLIENT_SECRET=

# Required for a public client: the key the session cookie is encrypted
# with. Generate one with `openssl rand -hex 32`. Without it the server
# refuses to enable login rather than encrypt sessions under a known key.
AUTH_COOKIE_KEY=

# Who may administer this deployment, comma separated. Entries are matched
# case insensitively against the token's email or principal id. A valid
# token only proves who is calling; this list decides whether they may
# manage short links. Leaving it empty rejects every login.
AUTH_ALLOWED_PRINCIPALS=

# Optional. Defaults to <host>/a/.auth/callback, which is correct unless
# the service is reached under a different public name. Set it when
# developing locally, e.g. http://localhost:9150/a/.auth/callback.
# The callback follows a.prefix when that is not /a/.
AUTH_REDIRECT_URL=

# Optional. Drops the Secure flag so sessions survive a local plain HTTP
# run. Never set this on a deployment.
AUTH_INSECURE_COOKIES=

# Only needed when gdpr.hide_ip is set. Addresses are stored as a digest
# keyed with this, because an unkeyed one can be reversed by computing
# every address. Keep it stable: unique visitors are counted over the
# digest, so changing it makes every returning visitor look new.
#
#   GORE_IP_HASH_KEY=$(openssl rand -hex 32)
GORE_IP_HASH_KEY=
